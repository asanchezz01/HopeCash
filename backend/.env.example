# Ambiente: development | test | production
NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_db
DB_PASSWORD=senha_db
DB_NAME=hopecash

# JWT — troque em produção (>= 32 chars aleatórios)
JWT_SECRET=change-me-in-production-please-32ch
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Logs: fatal|error|warn|info|debug
LOG_LEVEL=info

# LLM via Groq — assistente, interpretação de lançamentos e insights
# AI_ENABLED=false bloqueia todas as chamadas da Hope no backend.
AI_ENABLED=true
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=30000
GROQ_REASONING_EFFORT=low
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_CHAT=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# TTS via Azure Speech (recurso na mesma região informada abaixo).
TTS_ENABLED=true
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_ENDPOINT=https://brazilsouth.api.cognitive.microsoft.com/
AZURE_SPEECH_VOICE=pt-BR-ThalitaMultilingualNeural
TTS_FORMAT=mp3
TTS_SPEED=0.96

# Retaguarda — superusuário provisionado automaticamente na inicialização
SUPERUSER_EMAIL=admin@hopecash.app
SUPERUSER_NAME=Super Admin
SUPERUSER_PASSWORD=troque-esta-senha

# E-mail (SMTP) para reset de senha dos usuários do app.
# MAIL_ENABLED=false → não envia de fato, apenas registra o conteúdo no log.
MAIL_ENABLED=false
MAIL_SMTP=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=usuario@gmail.com
MAIL_PASS=senha-de-app-do-gmail
MAIL_FROM=usuario@gmail.com
MAIL_USE_TLS=true

# Formulário público em https://hopecash.coagru.com.br/suporte/
# Reaproveita o SMTP acima e envia as solicitações para SUPPORT_EMAIL_TO.
SUPPORT_EMAIL_TO=suporte@exemplo.com
SUPPORT_EMAIL_SUBJECT_PREFIX=[HopeCash Suporte]
SUPPORT_RATE_LIMIT_MAX=5
SUPPORT_RATE_LIMIT_WINDOW_MINUTES=15

# Notificações push (Firebase Cloud Messaging)
# FIREBASE_ENABLED=false → o provedor fica em modo dry-run (nada é enviado de
# fato, mas a API/worker funcionam normalmente). Credenciais em docs/FLUTTERFIRE.md.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_BASE64=

# Processamento de notificações agendadas (campanhas + avisos de vencimento)
PUSH_SCHEDULER_ENABLED=false
PUSH_SCHEDULER_INTERVAL_MS=60000
PUSH_DUE_REMINDER_DAYS=3
PUSH_DEFAULT_TIMEZONE=America/Sao_Paulo
# URL pública do app Web/PWA — só usada para montar o botão de ação do e-mail
# de fallback (usuário sem nenhum dispositivo push ativo). Reaproveita o
# mesmo SMTP configurado acima (MAIL_*); sem isso definido, o e-mail sai sem
# botão, só com o texto informativo.
PUSH_EMAIL_APP_URL=https://hopecash.coagru.com.br
