{
  "name": "hopecash-backend",
  "version": "0.1.0",
  "description": "HopeCash API — gestão financeira pessoal e familiar (NewHope)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "eval:ai": "node scripts/eval-ai.js",
    "test": "cross-env NODE_ENV=test CEREBRAS_API_KEY= vitest run",
    "test:watch": "cross-env NODE_ENV=test CEREBRAS_API_KEY= vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.0.1",
    "mysql2": "^3.11.0",
    "nodemailer": "^9.0.3",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "better-sqlite3": "^12.2.0",
    "cross-env": "^7.0.3",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
